{
  "name": "tommychow.com",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "gallery": "tsx scripts/generate-gallery-manifest.ts",
    "prebuild": "pnpm gallery",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "tsc --noEmit && eslint && prettier . --check && pnpm build",
    "ui:add": "shadcn add --yes",
    "ui:update": "shadcn add --overwrite --yes",
    "ui:diff": "node -e \"const fs=require('fs'),{spawnSync}=require('child_process');const ui=fs.existsSync('src/components/ui')?fs.readdirSync('src/components/ui').filter(f=>f.endsWith('.tsx')).map(f=>f.slice(0,-4)):[];const items=[...ui,...(fs.existsSync('src/hooks/use-mobile.ts')?['use-mobile']:[]),'utils'];spawnSync('shadcn add '+items.join(' ')+' --dry-run',{stdio:'inherit',shell:true})\"",
    "clean": "node -e \"['.next','.open-next','node_modules'].forEach(p=>require('fs').rmSync(p,{recursive:true,force:true}))\"",
    "nuke": "node -e \"const fs=require('fs'); ['.next','.open-next','node_modules'].forEach(p=>fs.rmSync(p,{recursive:true,force:true})); fs.rmSync('pnpm-lock.yaml',{force:true})\""
  },
  "dependencies": {
    "@base-ui/react": "=1.8.0",
    "class-variance-authority": "=0.7.1",
    "cn": "=0.3.2",
    "lucide-react": "=1.47.0",
    "motion": "=12.43.0",
    "next": "=16.3.5",
    "next-themes": "=0.4.6",
    "nuqs": "=2.10.1",
    "react": "=19.3.0",
    "react-dom": "=19.3.0",
    "server-only": "=0.0.1",
    "thumbhash": "=0.1.1",
    "tw-animate-css": "=1.4.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "=5.20.0",
    "@eslint/js": "=10.0.1",
    "@next/eslint-plugin-next": "=16.3.5",
    "@opennextjs/cloudflare": "=1.20.6",
    "@tailwindcss/postcss": "=4.3.3",
    "@tailwindcss/typography": "=0.5.20",
    "@types/node": "=24.13.6",
    "@types/react": "=19.3.0",
    "@types/react-dom": "=19.3.0",
    "babel-plugin-react-compiler": "=1.0.0",
    "eslint": "=10.11.0",
    "eslint-config-prettier": "=10.1.8",
    "eslint-plugin-better-tailwindcss": "=4.7.0",
    "eslint-plugin-react-you-might-not-need-an-effect": "=1.0.2",
    "exifr": "=7.1.3",
    "postcss": "=8.5.28",
    "prettier": "=3.9.8",
    "prettier-plugin-organize-imports": "=4.3.0",
    "prettier-plugin-tailwindcss": "=0.8.1",
    "shadcn": "=4.21.0",
    "sharp": "=0.35.4",
    "tailwindcss": "=4.3.3",
    "tsx": "=4.23.13",
    "typescript": "=6.0.3",
    "typescript-eslint": "=8.70.0",
    "wrangler": "=4.135.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.27.0+sha512.ad12821463bb143295f1fa3ecde77a6b9b97a7990386da800ff57bffc3964dc64b7b1c7559d5dbe5c337aea659ed9c8937d4370bd198ca2009bc6fa0249808e7"
}
